.data
SYSREAD = 0
STDIN = 0
SYSWRITE = 1
STDOUT = 1
SYSOPEN = 2
SYSCLOSE = 3
FREAD = 0
FWRITE = 1
SYSEXIT = 60
EXIT_SUCCESS = 0
file1: .ascii "file1.txt\0"
file2: .ascii "file2.txt\0"
result: .ascii "result.txt\0"
s: .asciz "%s"
float: .float 50.2

.bss
.comm number1, 65		# 64 + \n
.comm number2, 65
.comm module1, 53		
.comm module2, 53		
.comm mul_modules, 65

.text
.global main
main:

push $number1
push $file1
call read_from_file
add $16, %rsp

push $number2
push $file2
call read_from_file
add $16, %rsp

call make_modules

push $module1
push $0
push $53
call decode_number
add $24, %rsp
mov %r9, %r13			# module1 value in r13

push $module2
push $0
push $53
call decode_number
add $24, %rsp
mov %r9, %r14			# module2 value in r14

call multiply_modules

movq $float, %xmm0

mov $SYSEXIT, %rax
mov $EXIT_SUCCESS, %rdi
syscall


multiply_modules:
	xor %rdx, %rdx
	mov %r13, %rax
	mul %r14
	mov %rax, %r15
	ret

# f( higher index, less index, buff )
# result in r9
decode_number:
	push %rbp
	mov %rsp, %rbp

	mov 16(%rbp), %rcx
	mov $1, %r8
	mov $0, %r9
	mov 32(%rbp), %r10

	decode_loop:
		mov (%r10, %rcx, 1), %bl
		sub $0x30, %bl
		mov %r8, %rax
		mul %bl
		xor %rdx, %rdx
		add %rax, %r9
		shl %r8
		dec %rcx
		cmp 24(%rbp), %rcx
		jge decode_loop

	mov %rbp, %rsp
	pop %rbp
	ret

make_modules:
	mov $0, %rcx
	mov $12, %rsi

	movb $0x31, module1(, %rcx, 1)
	movb $0x31, module2(, %rcx, 1)

	inc %rcx
	
	modules_loop:
		mov number1(, %rsi, 1), %bl
		mov number2(, %rsi, 1), %bh
		mov %bl, module1(, %rcx, 1)
		mov %bh, module2(, %rcx, 1)
		inc %rcx
		inc %rsi
		cmp $63, %rsi
		jle modules_loop

	ret

read_from_file:
	push %rbp
	mov %rsp, %rbp
	
	mov $SYSOPEN, %rax		# file descriptor in rax
	mov 16(%rbp), %rdi
	mov $FREAD, %rsi
	mov $0, %rdx
	syscall

	mov %rax, %r8

	mov $SYSREAD, %rax
	mov %r8, %rdi
	mov 24(%rbp), %rsi
	mov $65, %rdx
	syscall

	mov $SYSCLOSE, %rax
	mov %r8, %rdi
	mov $0, %rsi
	mov $0, %rdx
	syscall
	
	mov %rbp, %rsp
	pop %rbp
	ret
